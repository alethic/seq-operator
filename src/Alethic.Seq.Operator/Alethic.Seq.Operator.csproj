<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
        <Nullable>enable</Nullable>
        <!-- Self-contained only when a runtime identifier is actually in play, which is the container publish
             (dist-containers sets RuntimeIdentifier=linux-x64). Set unconditionally it also applies to a plain
             build, which makes the assembly a RID-scoped asset of anything referencing this project: the test
             project then resolves it on win-x64 and linux-x64 but not on linux-arm64, which is not in
             RuntimeIdentifiers. The published image is unaffected, since it always sets a RID. -->
        <SelfContained Condition=" '$(RuntimeIdentifier)' != '' ">true</SelfContained>
        <ContainerRepository>seq-operator-image</ContainerRepository>
        <KubeOpsCli>dotnet tool run kubeops</KubeOpsCli>
        <GenerateOperatorResources>true</GenerateOperatorResources>
    </PropertyGroup>

    <ItemGroup>
        <ContainerEnvironmentVariable Include="ASPNETCORE_FORWARDEDHEADERS_ENABLED" Value="true" />
        <ContainerEnvironmentVariable Include="ASPNETCORE_ENVIRONMENT" Value="Production" />
        <ContainerEnvironmentVariable Include="ASPNETCORE_HTTP_PORTS" Value="8080" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="KubeOps.Generator" Version="13.1.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="KubeOps.Operator" Version="13.1.0" />
        <PackageReference Include="Seq.Api" Version="2025.2.2" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="config\" />
    </ItemGroup>

</Project>
